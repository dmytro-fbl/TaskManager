{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=task_tracker_db;Username=YOUR_USER_NAME(DEFAULT:postgres);Password=YOUR_PASSWORD_HERE"
    },
    "Jwt": {
        "Key": "SET_VIA_USER_SECRETS",
        "Issuer": "TaskManagerExample.API",
        "Audience": "TaskManagerExample.Client",
        "ExpireMinutes": 15
    },
    "Cors": {
        "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5174" ]
    },
    "AllowedHosts": "*"
}
